// 數學資料是主體：角色的位置 = 碰撞圓的圓心，圖片只是畫在上面的外觀。
//
//   r              戰鬥判定圓的半徑（遊戲 px），永遠以角色位置為圓心，不能偏移
//   image.width    圖片在遊戲裡顯示的寬度（遊戲 px），跟圖片解析度無關，高度照圖片比例
//   image.x / y    圖片中心相對「角色位置」的偏移，y 往下為正，可省略（= 0）
//
// 例：瘦長胡蘿蔔只有下半身算判定——判定圓不動，把圖往上畫 12px，圓就落在下半身
//   "carrot": { "r": 10, "image": { "width": 24, "y": -12 } },
//
// 角色左右翻面時 image.x 會自動鏡像。
// 遊戲中按 H 顯示／隱藏所有碰撞圓；dev server 開著時存檔會自動重新載入。
// key 對應 public/images 的一張圖（敵人的 key 與 enemies.ts 一致）。
{
  "player":   { "r": 21, "image": { "width": 60 } },

  // ── 敵人 ──
  "carrot":   { "r": 12, "image": { "width": 36, "y": -5 } },  // 身體中心在圖片偏下，圖往上挪讓圓對準身體、不含葉子
  "onion":    { "r": 15, "image": { "width": 34, "y": -3 } },  // 球體中心偏下，圖往上挪讓圓貼齊球體、不含尖頂
  "chili":    { "r": 13, "image": { "width": 34, "x": -2.5, "y": 1.5 } },  // 直長圖（高 = 寬 1.5 倍），身體偏右上，圓對準有臉的身體、不含蒂頭與尾巴
  "cabbage":  { "r": 20, "image": { "width": 44 } },
  "eggplant": { "r": 17, "image": { "width": 38 } },
  "broccoli": { "r": 19, "image": { "width": 42 } },
  "scallion": { "r": 14, "image": { "width": 32 } },
  "pumpkin":  { "r": 26, "image": { "width": 56 } },

  "boss":     { "r": 52, "image": { "width": 112 } },

  // ── 其他 ──
  "gem":      { "r": 6,  "image": { "width": 12 } },  // r 是撿取範圍；大寶石只是看起來大，r 不變
  "particle": {          "image": { "width": 8 } },   // 沒有碰撞
  "ground":   {          "image": { "width": 80 } },  // 一格地板，會平鋪
}
